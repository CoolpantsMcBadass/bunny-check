{
  "manifest_version": 3,
  "name": "BunnyCheck",
  "version": "0.9.1",
  "description": "Detects cruelty-free beauty brands near product images and overlays PETA and Leaping Bunny certification badges.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.ulta.com/*",
    "https://www.sephora.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ulta.com/*"],
      "js": ["matcher.js", "adapters/ulta.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.sephora.com/*"],
      "js": ["matcher.js", "adapters/sephora.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BunnyCheck",
    "default_icon": {
      "16": "icons/bunny-16.png",
      "32": "icons/bunny-32.png",
      "48": "icons/bunny-48.png",
      "128": "icons/bunny-128.png"
    }
  },
  "icons": {
    "16": "icons/bunny-16.png",
    "32": "icons/bunny-32.png",
    "48": "icons/bunny-48.png",
    "128": "icons/bunny-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/bunny-64.png"],
      "matches": ["https://www.ulta.com/*", "https://www.sephora.com/*"]
    }
  ]
}
